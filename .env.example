# Copy to .env and adjust. The application validates these values at boot.
HTTP_ADDR=:8080
LOG_LEVEL=info
APP_ENV=dev
DEBUG_AUTH_STUB=true
DATABASE_URL=postgres://quewe:quewe@localhost:5432/quewe?sslmode=disable

# Tuning (optional)
# LEASE_DURATION=60s
# HEARTBEAT_INTERVAL=20s
# REAPER_INTERVAL=15s
# POLL_WAIT_SECONDS=20
# MAX_RESERVE=1